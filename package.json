{
  "name": "pi-regraft",
  "version": "0.2.0",
  "description": "Vendor code from an upstream git repo into your project as plain files, then re-pull upstream changes without losing your local edits. Ships a Pi extension that hands merge conflicts to the agent to resolve.",
  "type": "module",
  "license": "MIT",
  "author": "Onur Solmaz",
  "files": [
    "dist",
    "docs",
    "extensions",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "vendor",
    "vendoring",
    "upstream",
    "merge",
    "fork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osolmaz/pi-regraft.git"
  },
  "pi": {
    "extensions": [
      "extensions"
    ]
  },
  "bin": {
    "regraft": "dist/cli-main.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
