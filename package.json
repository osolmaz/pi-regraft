{
  "name": "pi-regraft",
  "version": "0.3.0",
  "description": "Vendor and update upstream code as plain files, with a dedicated Pi agent for resumable conflict resolution.",
  "type": "module",
  "license": "MIT",
  "author": "Onur Solmaz",
  "files": [
    "dist",
    "docs",
    "regrafter",
    "scripts/bin/regraft",
    "scripts/regrafter-pi-with-path.mjs",
    "src",
    "pi-factory.toml",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "vendor",
    "vendoring",
    "upstream",
    "merge",
    "fork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osolmaz/pi-regraft.git"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "bin": {
    "regraft": "dist/cli-main.js",
    "regrafter": "dist/regrafter/cli-main.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./regrafter": {
      "types": "./dist/regrafter/index.d.ts",
      "default": "./dist/regrafter/index.js"
    },
    "./regrafter/cli": {
      "types": "./dist/regrafter/cli.d.ts",
      "default": "./dist/regrafter/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-cli.mjs",
    "format": "prettier --check src/extension.ts \"src/regrafter/**/*.ts\" \"test/regrafter/**/*.ts\" \"regrafter/**/*.md\" \"scripts/regrafter-*.mjs\" scripts/bin/regraft package.json eslint.config.mjs vitest.config.ts stryker.config.mjs slophammer.yml AGENTS.md",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "package-smoke": "node scripts/regrafter-package-smoke.mjs",
    "dry": "slophammer-ts dry .",
    "boundaries": "slophammer-ts boundaries .",
    "mutate": "stryker run",
    "slophammer": "slophammer-ts check .",
    "check": "npm run format && npm run lint && npm run typecheck && npm test && npm run coverage && npm run build && npm run package-smoke && npm run dry && npm run boundaries && npm run slophammer",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@osolmaz/pi-factory": "^0.2.0",
    "@sinclair/typebox": "^0.34.0",
    "cross-spawn": "^7.0.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@eslint/js": "^9.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "slophammer-ts": "0.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
